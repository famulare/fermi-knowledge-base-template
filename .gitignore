# macOS
**/.DS_Store

# Python virtual environment
.venv/
__pycache__/
*.pyc

# Ephemeral views (regenerated each session)
views/ephemeral/

# Generated retrieval index (rebuildable from markdown via scripts/kb_search.py rebuild)
index/kb_index.db

# Generated knowledge graph (rebuildable via scripts/kb_graph.py build)
index/graph.json

# Audit output (regenerated by scripts/kb_audit.py)
audit_results/

# Local-only Claude settings
.claude/settings.local.json

# IDE artifacts
.vscode/
.idea/
*.swp
*.swo

# Temp files
*.tmp
*~
*.log
